+# --- Patched for the Wukong paper (same-model baseline): OpenAI Responses API, reasoning effort, bounded retries,
+# token accounting. The original called chat.completions with temperature=0, which reasoning models reject, and
+# retried forever on any error.
+import atexit
+import json as _json
+
+USAGE = {"calls": 0, "failed_calls": 0, "input_tokens": 0, "cached_tokens": 0, "output_tokens": 0, "reasoning_tokens": 0}
+_ATTEMPTS = 6
+_REASONING_EFFORT = os.environ.get("EDC_REASONING_EFFORT", "low")
+_REASONING_BUDGET = 4096  # extra output tokens for reasoning, on top of the visible-output limit
+
+
+def _dump_usage():
+    path = os.environ.get("EDC_USAGE_PATH")
+    if path:
+        with open(path, "w") as f:
+            _json.dump(USAGE, f, indent=2)
+
+
+atexit.register(_dump_usage)
+
+
 def openai_chat_completion(model, system_prompt, history, temperature=0, max_tokens=512):
