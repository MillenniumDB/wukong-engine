            "description": "An entity of the type \"film\", as defined by the Movie Ontology.",
            "primary_key": "name",
            "deduplication": "primary_key",
            "fields": {
                "name": {
                    "data_type": "string",
                    "description": "The text that identifies this Film in the source text.",
                    "instructions": "Use the exact surface form as it appears in the source text, without adding, removing, reordering or normalizing any words.",
                    "required": true,
                    "retrieval_mode": "extract"
