# Generated benchmark artifacts.
# The workspace definitions (knowledge_model.json, document_collections.json,
# text2kg_mapping.json) stay tracked so runs are reproducible from the repo.

# Test sentences, reproducible from the Text2KGBench repository
data/

# Per-run engine state and exports
workspaces/*/staging/
workspaces/*/exports/

# Generated results, except the three that are the scientific record of a run:
# the converted system output, the evaluator's metrics, and the run record
# (tokens, jobs, engine and config) of text2kg_record.py. Its archive/ copy of
# the staging database and log stays untracked: back it up elsewhere.
# The results-* trees are the ablation arms of paper/benchmark.md section 10,
# and the adjusted run of paper/benchmark-adjusted.md, whose scoring/ holds the
# re-scored metrics.
results/*
!results/wukong/
!results/eval/
!results/runs/
results-*/*
!results-*/wukong/
!results-*/eval/
!results-*/runs/
!results-*/scoring/
# Baseline runs (prompting, EDC, KGGen) write their converted output to llm/ instead of wukong/,
# and the type-conformance check keeps its judgements, summary and hand-check sample
!results-*/llm/
!results-typecheck/*

# Written per run with absolute paths, so it is machine specific
results/eval/eval_config.json
results-*/eval/eval_config.json
results-*/scoring/**/eval_config.json

# Re-scoring keeps only the averages and summary.json: the per-sentence metrics
# of every system under every variant run to ~85 MB and are deterministic
results-*/scoring/**/ont_*_stats.jsonl
!results-*/scoring/**/ont_avg_stats.jsonl

# Corrected benchmark copies, regenerated by text2kg_rescore.py
/scoring/

# Evaluator environment (nltk), recreated by the setup steps in paper/benchmark.md
.venv-eval/
