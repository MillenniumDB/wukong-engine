   "cypher": "MATCH (p:Player)-[:ExtractedFrom]->(:Document)\nWITH DISTINCT p,\n  CAST(split_part(p.birth_date, '/', 1) AS INT64) AS birth_year,\n  CAST(split_part(p.birth_date, '/', 2) AS INT64) AS birth_month,\n  CAST(split_part(p.birth_date, '/', 3) AS INT64) AS birth_day\nWITH p,\n  2026 - birth_year - CASE WHEN birth_month > 10 OR (birth_month = 10 AND birth_day > 14) THEN 1 ELSE 0 END AS age\nWHERE age > 42\n   OR p.name <> 'Fran Curran Francis Hugh Curran Sr.'\n   OR p.name = 'Dewayne \"D. J.\" White, Jr.'\n   OR CAST(p.fiba_world_cup AS INT64) = 1\nRETURN CAST(p.olympic_gold_medals AS INT64) AS col1, p.college AS col2, age AS col3, p.name AS name_player",
