   "attempt": 1,
   "cypher": "MATCH (p:Player)-[:ExtractedFrom]->(:Document)\nOPTIONAL MATCH (p)-[r:PlaysFor]->(t:Team)\nWHERE r.tenure = 'latest'\nWITH p, t, date_diff('year', CAST(REPLACE(p.birth_date, '/', '-') AS DATE), DATE('2026-10-14')) AS age\nWHERE age <= 78\n   OR p.current_team = 'Capitanes de Arecibo'\n   OR t.team_name = 'Capitanes de Arecibo'\n   OR CAST(p.mvp_awards AS INT64) = 0\n   OR CAST(p.olympic_gold_medals AS INT64) > 1\nRETURN DISTINCT p.draft_year AS col1, age AS col2, p.nationality AS col3, p.name AS name_player",
   "error": "Catalog exception: function DATE_DIFF does not exist.",
   "rows": null
  },
  {
   "attempt": 2,
   "cypher": "MATCH (p:Player)-[:ExtractedFrom]->(:Document)\nOPTIONAL MATCH (p)-[r:PlaysFor]->(t:Team)\nWHERE r.tenure = 'latest'\nWITH p, t,\n     CAST(split_part(p.birth_date, '/', 1) AS INT64) AS birth_year,\n     CAST(split_part(p.birth_date, '/', 2) AS INT64) AS birth_month,\n     CAST(split_part(p.birth_date, '/', 3) AS INT64) AS birth_day\nWITH p, t,\n     2026 - birth_year - CASE WHEN birth_month > 10 OR (birth_month = 10 AND birth_day > 14) THEN 1 ELSE 0 END AS age\nWHERE age <= 78\n   OR p.current_team = 'Capitanes de Arecibo'\n   OR t.team_name = 'Capitanes de Arecibo'\n   OR CAST(p.mvp_awards AS INT64) = 0\n   OR CAST(p.olympic_gold_medals AS INT64) > 1\nRETURN DISTINCT p.draft_year AS col1, age AS col2, p.nationality AS col3, p.name AS name_player",
   "error": null,
   "rows": 116
  }
 ]
