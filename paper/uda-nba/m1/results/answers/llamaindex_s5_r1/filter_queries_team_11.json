   "cypher": "MATCH (t:Team)-[:MentionedIn]->(:Document)\nMATCH (t)-[:LocatedIn]->(c:City)\nWHERE ((CAST(t.founded_year AS INT64) >= 1949 AND CAST(t.founded_year AS INT64) = 1949)\n   OR (EXISTS { MATCH (o1:Owner)-[:Owns]->(t) WHERE o1.name <> 'Ted Leonsis' }\n       AND EXISTS { MATCH (o2:Owner)-[:Owns]->(t) WHERE o2.name <> 'Professional Basketball Club LLC' }))\nRETURN DISTINCT c.city_name AS col1, t.founded_year AS col2, t.team_name AS col3, t.team_name AS name_team",
   "error": null,
   "rows": 118
  }
 ]
