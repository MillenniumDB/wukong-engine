   "attempt": 1,
   "cypher": "MATCH (p:Player)-[:ExtractedFrom]->(:Document)\nWHERE (CAST(p.olympic_gold_medals AS INT64) > 1)\n   OR (p.position IS NOT NULL AND p.position <> 'Frontcourt')\nWITH p, COALESCE(p.death_date, '2026/10/14') AS end_date\nWITH p,\n     CAST(split_part(end_date, '/', 1) AS INT64) AS end_year,\n     CAST(split_part(end_date, '/', 2) AS INT64) AS end_month,\n     CAST(split_part(end_date, '/', 3) AS INT64) AS end_day,\n     CAST(split_part(p.birth_date, '/', 1) AS INT64) AS birth_year,\n     CAST(split_part(p.birth_date, '/', 2) AS INT64) AS birth_month,\n     CAST(split_part(p.birth_date, '/', 3) AS INT64) AS birth_day\nRETURN CAST(p.olympic_gold_medals AS INT64) AS col1,\n       CAST(p.nba_championships AS INT64) AS col2,\n       end_year - birth_year - CASE WHEN end_month < birth_month OR (end_month = birth_month AND end_day < birth_day) THEN 1 ELSE 0 END AS col3,\n       p.name AS name_player",
