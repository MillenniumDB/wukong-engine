# By default, files are treated as text and normalized automatically
* text=auto

# Strongly enforce LF line endings for UNIX-style scripts and configuration files
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Strongly enforce CRLF line endings for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat images as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.webp binary

# Treat fonts as binary
*.ttf binary
*.otf binary